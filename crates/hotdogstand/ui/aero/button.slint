// Push buttons, the flat buttons of the command bar, and the check box.

import { Theme } from "../theme.slint";

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // The default button of a window has a blue border, like the button that
    // Enter presses in Windows 7.
    in property <bool> primary;
    callback clicked();

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;

    min-width: max(75px, label.preferred-width + 20px);
    height: Theme.control-height;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: !root.enabled ? #adb2b5
        : touch.pressed ? Theme.button-border-pressed
        : touch.has-hover || focus.has-focus || root.primary ? Theme.button-border-hover
        : Theme.button-border;
    background: !root.enabled ? #f4f4f4
        : touch.pressed ? Theme.button-face-pressed
        : touch.has-hover ? Theme.button-face-hover
        : Theme.button-face;

    // The light line inside the border.
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: Theme.control-radius - 1px;
        border-width: 1px;
        border-color: touch.pressed ? transparent : #ffffffb0;
    }

    // The ring of the focus, inside the button.
    if focus.has-focus: Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-width: 1px;
        border-color: Theme.focus-ring.with-alpha(0.5);
        border-radius: 1px;
    }

    label := Text {
        text: root.text;
        color: root.enabled ? Theme.text : Theme.disabled-text;
        font-family: Theme.font-family;
        font-size: Theme.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

// A flat button with a glass face on hover, for the command bar.
export component CommandButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // A small arrow after the text, for a button that opens a menu.
    in property <bool> has-menu;
    callback clicked();

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    height: 26px;
    width: layout.preferred-width;
    border-radius: 3px;
    border-width: touch.has-hover && root.enabled ? 1px : 0px;
    border-color: Theme.command-hover-border;
    background: touch.has-hover && root.enabled ? Theme.command-hover : transparent;

    layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.disabled-text
                : Theme.hds && touch.has-hover ? #000000
                : Theme.command-text;
            font-family: Theme.font-family;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }
        if root.has-menu: Path {
            width: 7px;
            height: 4px;
            y: (parent.height - 4px) / 2;
            viewbox-width: 7;
            viewbox-height: 4;
            commands: "M 0 0 L 7 0 L 3.5 4 Z";
            fill: Theme.hds && !touch.has-hover ? #ffffff : Theme.command-text;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component CheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    // A small square of color before the text, for a label.
    in property <color> swatch: transparent;
    callback toggled(bool);

    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => { root.toggle(); }
    forward-focus: focus;

    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    height: 18px;
    min-width: layout.preferred-width;

    layout := HorizontalLayout {
        spacing: 5px;
        Rectangle {
            width: 13px;
            height: 13px;
            y: (parent.height - 13px) / 2;
            border-width: 1px;
            border-color: touch.has-hover ? Theme.field-border-hover : #8e8f8f;
            background: touch.has-hover
                ? @linear-gradient(135deg, #def9fa 0%, #b1dff8 100%)
                : @linear-gradient(135deg, #dcdcdc 0%, #ffffff 100%);
            Rectangle {
                x: 2px;
                y: 2px;
                width: 9px;
                height: 9px;
                background: touch.has-hover
                    ? @linear-gradient(135deg, #b1dff8 0%, #ebf8fe 100%)
                    : @linear-gradient(135deg, #cbcfd5 0%, #f7f7f7 100%);
            }
            if root.checked: Path {
                x: 2px;
                y: 2px;
                width: 9px;
                height: 9px;
                viewbox-width: 9;
                viewbox-height: 9;
                commands: "M 1 4.5 L 3.5 7 L 8 1.5";
                stroke: #4a5f97;
                stroke-width: 2px;
                fill: transparent;
            }
        }
        if root.swatch != transparent: Rectangle {
            width: 10px;
            height: 10px;
            y: (parent.height - 10px) / 2;
            background: root.swatch;
            border-width: 1px;
            border-color: root.swatch.darker(0.4);
            border-radius: 2px;
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.disabled-text;
            font-family: Theme.font-family;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }
        if focus.has-focus: Rectangle { width: 0px; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            root.toggle();
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " {
                root.toggle();
                return accept;
            }
            reject
        }
    }
}
