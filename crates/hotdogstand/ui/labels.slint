// The Labels window: the names and the colors of the labels.

import { AeroFrame, ResizeEdge, Button, TextField, InfoBar, FieldLabel, ScrollArea } from "aero/index.slint";
import { Theme } from "theme.slint";
import { LabelChip } from "types.slint";

export component LabelsWindow inherits Window {
    in property <bool> system-frame;
    in property <[LabelChip]> labels;
    in-out property <int> current: -1;
    in-out property <string> name;
    in-out property <int> color-index;
    in property <[color]> palette: [#c42b1c, #c46a00, #b8a000, #2e8b57, #1f7a8c, #3a6ea5, #7a3ab0, #6b6b6b];
    in-out property <string> error;

    callback add();
    callback save-changes();
    callback picked(int);
    callback minimize();
    callback close-window();

    property <bool> has-current: root.current >= 0 && root.current < root.labels.length;

    title: "Labels";
    icon: @image-url("../../../assets/hotdogstand.svg");
    no-frame: !root.system-frame;
    background: root.system-frame ? Theme.face : transparent;
    default-font-family: Theme.font-family;
    width: 380px;
    height: 440px;
    forward-focus: name-field;

    AeroFrame {
        title: root.title;
        icon: root.icon;
        system-frame: root.system-frame;
        resizable: false;
        minimize => { root.minimize(); }
        close => { root.close-window(); }

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            InfoBar { text <=> root.error; }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: Theme.field-border;
                background: Theme.content;
                ScrollArea {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    content-height: root.labels.length * Theme.row-height;
                    for label[i] in root.labels: Rectangle {
                        y: i * Theme.row-height;
                        height: Theme.row-height;
                        border-radius: 3px;
                        border-width: i == root.current || touch.has-hover ? 1px : 0px;
                        border-color: i == root.current ? Theme.row-selected-border : Theme.row-hover-border;
                        background: i == root.current ? Theme.row-selected
                            : touch.has-hover ? Theme.row-hover : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 8px;
                            Rectangle {
                                width: 12px;
                                height: 12px;
                                y: (parent.height - 12px) / 2;
                                border-radius: 2px;
                                background: label.color;
                                border-width: 1px;
                                border-color: label.color.darker(0.4);
                            }
                            Text {
                                text: label.name;
                                color: i == root.current && Theme.hds ? Theme.row-selected-text : Theme.text;
                                font-family: Theme.font-family;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                        }
                        touch := TouchArea {
                            clicked => {
                                root.current = i;
                                root.picked(i);
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Name:"; }
                name-field := TextField {
                    text <=> root.name;
                    accepted => { root.add(); }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: "Color:"; }
                for swatch[i] in root.palette: Rectangle {
                    accessible-role: radio-button;
                    accessible-label: "Color \{i + 1}";
                    accessible-checkable: true;
                    accessible-checked: i == root.color-index;
                    accessible-action-default => { root.color-index = i; }
                    width: 22px;
                    height: 22px;
                    border-radius: 3px;
                    border-width: i == root.color-index ? 2px : 1px;
                    border-color: i == root.color-index ? Theme.text : swatch.darker(0.4);
                    Rectangle {
                        x: 3px;
                        y: 3px;
                        width: parent.width - 6px;
                        height: parent.height - 6px;
                        border-radius: 2px;
                        background: swatch;
                    }
                    TouchArea {
                        clicked => { root.color-index = i; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                spacing: 7px;
                alignment: end;
                Button {
                    text: "Add";
                    primary: true;
                    enabled: root.name != "";
                    clicked => { root.add(); }
                }
                Button {
                    text: "Save changes";
                    enabled: root.has-current && root.name != "";
                    clicked => { root.save-changes(); }
                }
            }
        }
    }
}
