// The main window: the ticket list.

import { AeroFrame, ResizeEdge, CommandBar, CommandButton, TextField, ComboBox, DetailsList, StatusBar, InfoBar, FieldLabel } from "aero/index.slint";
import { Theme, ThemeName } from "theme.slint";
import { TicketRow, LabelChip } from "types.slint";
import { Menu, MenuItem } from "menu.slint";

export { Theme, ThemeName, ResizeEdge, TicketRow, LabelChip }
export { Markdown } from "types.slint";
export { TicketWindow } from "ticket.slint";
export { PeopleWindow } from "people.slint";
export { LabelsWindow } from "labels.slint";
export { AboutWindow } from "about.slint";

export component MainWindow inherits Window {
    in property <bool> system-frame;
    in property <bool> is-maximized;
    // True on macOS, where the menus go in the menu bar of the system.
    in property <bool> native-menu;
    // The check marks of the macOS menus. A click on a checkable item flips
    // its mark, so the Rust code sets all of them again after each change.
    in-out property <bool> mark-aero: true;
    in-out property <bool> mark-hot-dog-stand;
    in-out property <bool> mark-dark;
    in-out property <bool> mark-system-frame;
    in property <string> workspace-name;

    in property <[TicketRow]> rows;
    in property <int> sort-column;
    in property <bool> sort-descending;
    in-out property <int> current: -1;
    in-out property <[length]> widths: [52px, 330px, 90px, 74px, 120px, 150px, 120px];

    in property <[string]> status-choices: ["Open and in progress", "All", "Open", "In progress", "Closed"];
    in property <[string]> priority-choices: ["Any priority", "Low", "Normal", "High", "Urgent"];
    in property <[string]> assignee-choices: ["Anyone", "Nobody"];
    in property <[string]> label-choices: ["Any label"];
    in-out property <int> status-filter;
    in-out property <int> priority-filter;
    in-out property <int> assignee-filter;
    in-out property <int> label-filter;
    in-out property <string> search;

    in property <string> status-text;
    in-out property <string> error;

    callback filter-changed();
    callback sort(int);
    callback open-ticket(int);
    callback new-ticket();
    callback export-json();
    callback export-csv();
    callback show-people();
    callback show-labels();
    callback show-about();
    callback set-theme(ThemeName);
    callback set-system-frame(bool);
    callback set-dark(bool);

    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback start-resize(ResizeEdge);

    title: root.workspace-name == "" ? "HotDogStand" : "\{root.workspace-name} - HotDogStand";
    icon: @image-url("../../../assets/hotdogstand.svg");
    no-frame: !root.system-frame;
    background: root.system-frame ? Theme.face : transparent;
    default-font-family: Theme.font-family;
    preferred-width: 1000px;
    preferred-height: 600px;
    min-width: 640px;
    min-height: 360px;

    export-menu := Menu {
        x: export-button.absolute-position.x - root.absolute-position.x;
        y: export-button.absolute-position.y - root.absolute-position.y + export-button.height;
        items: [
            { text: "Workspace to JSON...", icon: @image-url("icons/export.svg") },
            { text: "List to CSV...", icon: @image-url("icons/export.svg") },
        ];
        activated(i) => {
            if i == 0 { root.export-json(); } else { root.export-csv(); }
        }
    }

    options-menu := Menu {
        x: options-button.absolute-position.x - root.absolute-position.x;
        y: options-button.absolute-position.y - root.absolute-position.y + options-button.height;
        items: [
            { text: "Aero", checked: Theme.name == ThemeName.aero },
            { text: "Hot Dog Stand", checked: Theme.name == ThemeName.hot-dog-stand },
            { separator: true },
            { text: "Dark mode", checked: Theme.dark },
            { text: "Use the system frame", checked: root.system-frame },
        ];
        activated(i) => {
            if i == 0 { root.set-theme(ThemeName.aero); }
            if i == 1 { root.set-theme(ThemeName.hot-dog-stand); }
            if i == 3 { root.set-dark(!Theme.dark); }
            if i == 4 { root.set-system-frame(!root.system-frame); }
        }
    }

    // The menus in the menu bar of macOS. The same actions are in the
    // command bar of the window, for the systems that have no such bar.
    if root.native-menu: MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New Ticket";
                shortcut: @keys(Meta + N);
                activated => { root.new-ticket(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Export Workspace to JSON...";
                shortcut: @keys(Meta + E);
                activated => { root.export-json(); }
            }
            MenuItem {
                title: "Export List to CSV...";
                activated => { root.export-csv(); }
            }
        }
        Menu {
            title: "Workspace";
            MenuItem {
                title: "People...";
                activated => { root.show-people(); }
            }
            MenuItem {
                title: "Labels...";
                activated => { root.show-labels(); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Aero";
                checkable: true;
                checked <=> root.mark-aero;
                activated => { root.set-theme(ThemeName.aero); }
            }
            MenuItem {
                title: "Hot Dog Stand";
                checkable: true;
                checked <=> root.mark-hot-dog-stand;
                activated => { root.set-theme(ThemeName.hot-dog-stand); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Dark Mode";
                checkable: true;
                checked <=> root.mark-dark;
                shortcut: @keys(Meta + Shift + D);
                activated => { root.set-dark(!Theme.dark); }
            }
            MenuItem {
                title: "Use the System Frame";
                checkable: true;
                checked <=> root.mark-system-frame;
                activated => { root.set-system-frame(!root.system-frame); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "About HotDogStand";
                activated => { root.show-about(); }
            }
        }
    }

    forward-focus: list;

    keys := FocusScope {
        capture-key-pressed(event) => {
            // Access keys, as in Windows: Alt and the first letter of a
            // command.
            if event.modifiers.alt && !event.modifiers.control && !event.modifiers.meta {
                if event.text == "n" || event.text == "N" { root.new-ticket(); return accept; }
                if event.text == "e" || event.text == "E" { export-menu.show(); return accept; }
                if event.text == "p" || event.text == "P" { root.show-people(); return accept; }
                if event.text == "l" || event.text == "L" { root.show-labels(); return accept; }
                if event.text == "o" || event.text == "O" { options-menu.show(); return accept; }
                if event.text == "a" || event.text == "A" { root.show-about(); return accept; }
            }
            // Shortcuts with Control, or with Command on macOS. The menu
            // bar of macOS holds its own shortcuts, so only the ones that it
            // does not have are here.
            if (event.modifiers.control && !root.native-menu) || (event.modifiers.meta && root.native-menu) {
                if event.text == "f" || event.text == "F" { search.focus(); return accept; }
                if !root.native-menu && (event.text == "n" || event.text == "N") { root.new-ticket(); return accept; }
            }
            reject
        }

        AeroFrame {
            title: root.title;
            icon: root.icon;
            system-frame: root.system-frame;
            maximized: root.is-maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close => { root.close-window(); }
            start-resize(edge) => { root.start-resize(edge); }

            CommandBar {
                CommandButton {
                    text: "New ticket";
                    icon: @image-url("icons/new-ticket.svg");
                    clicked => { root.new-ticket(); }
                }
                export-button := CommandButton {
                    text: "Export";
                    icon: @image-url("icons/export.svg");
                    has-menu: true;
                    clicked => { export-menu.show(); }
                }
                CommandButton {
                    text: "People";
                    icon: @image-url("icons/people.svg");
                    clicked => { root.show-people(); }
                }
                CommandButton {
                    text: "Labels";
                    icon: @image-url("icons/labels.svg");
                    clicked => { root.show-labels(); }
                }
                Rectangle { horizontal-stretch: 1; }
                options-button := CommandButton {
                    text: "Options";
                    icon: @image-url("icons/options.svg");
                    has-menu: true;
                    clicked => { options-menu.show(); }
                }
                CommandButton {
                    text: "About";
                    icon: @image-url("icons/about.svg");
                    clicked => { root.show-about(); }
                }
            }

            InfoBar {
                text <=> root.error;
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 6px;
                FieldLabel { text: "Show:"; }
                ComboBox {
                    width: 150px;
                    model: root.status-choices;
                    current-index <=> root.status-filter;
                    selected => { root.filter-changed(); }
                }
                ComboBox {
                    width: 110px;
                    model: root.priority-choices;
                    current-index <=> root.priority-filter;
                    selected => { root.filter-changed(); }
                }
                FieldLabel { text: "Assigned to:"; }
                ComboBox {
                    width: 120px;
                    model: root.assignee-choices;
                    current-index <=> root.assignee-filter;
                    selected => { root.filter-changed(); }
                }
                FieldLabel { text: "Label:"; }
                ComboBox {
                    width: 110px;
                    model: root.label-choices;
                    current-index <=> root.label-filter;
                    selected => { root.filter-changed(); }
                }
                Rectangle { horizontal-stretch: 1; }
                search := TextField {
                    width: 200px;
                    placeholder: "Search titles or #number";
                    text <=> root.search;
                    edited => { root.filter-changed(); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.separator;
            }

            list := DetailsList {
                vertical-stretch: 1;
                rows: root.rows;
                titles: ["#", "Title", "Status", "Priority", "Assigned to", "Labels", "Updated"];
                widths <=> root.widths;
                sort-column: root.sort-column;
                sort-descending: root.sort-descending;
                current <=> root.current;
                labels-column: 5;
                priority-column: 3;
                empty-text: "No ticket matches. Change the filter, or make a new ticket.";
                sort(c) => { root.sort(c); }
                activate(i) => { root.open-ticket(i); }
            }

            StatusBar {
                text: root.status-text;
            }
        }
    }
}
