# The output of cargo. It is made from the source.
/target/

# A workspace file. It holds the tickets of one person, and the application
# makes a new one at the first start.
*.db
*.db-journal
*.db-wal
*.db-shm

# macOS writes these into every directory it looks at.
.DS_Store

# The settings of whichever assistant a contributor uses. What the project
# asks of one is in AGENTS.md, which every contributor reads and no tool has
# to be configured to obey.
.claude/
